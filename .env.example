# cp .env.example .env  — .env git'e eklenmez (bkz. .gitignore)

# ── hbbs (relay adresi dış dünyadan erişilen hbbr) ──
HBBS_RELAY_ADDR=your.public.ip.or.dns:21117

# ── rustdesk-api ──
API_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
PUBLIC_BASE_URL=https://panel.example.com
# Ters proxy (nginx/traefik) SSL sonlandırıyorsa 1
TRUST_PROXY=1
# HTTPS panel: genelde 1; HTTP test: 0
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax

# Panel JS/CSS sürümü — güncelleme sonrası tarayıcı önbelleğini kırmak için +1 yapın
STATIC_ASSET_VERSION=14

# RustDesk audit (Kaynak/Hedef)
# CONN_AUDIT_PEER_SWAP=1

# ── RDGen (GitHub PAT, fork ile aynı GENURL/ZIP_PASSWORD) ──
GHUSER=
GHBEARER=
RDGEN_SECRET_KEY=
RDGEN_ZIP_PASSWORD=
GENURL=https://panel.example.com/
