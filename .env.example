# Kopyalayin: cp .env.example .env  ve degerleri doldurun (.env git'e eklenmez)
# RustDesk audit Kaynak/Hedef eslemesi: 1=yer degistir (varsayilan), 0=RustDesk ham hali
# CONN_AUDIT_PEER_SWAP=1

# RDGen (GitHub API — fine-grained veya classic PAT)
GHBEARER=

RDGEN_SECRET_KEY=
RDGEN_ZIP_PASSWORD=
GENURL=https://example.com/

# rustdesk-api (docker-compose.portainer)
API_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
